  m_Name: 
  m_EditorClassIdentifier: 
  panel: {fileID: 2439316527963396214}
  dialogueText: {fileID: 1085051012974489677}
  choicesParent: {fileID: 0}
  choiceButtonPrefab: {fileID: 0}
  startNode: 0
  nodes:
  - text: "[anim=tremendinho]Pois n\xE3o meu amigo[/anim]"
    autoNextNode: 1
    choices: []
  - text: "[anim=tremendinho]Meu nome \xE9 Jean Arisquadison Fernando Segundo, mas
      pode me chamar de LULA\nEncantado![/anim]"
    autoNextNode: 2
    choices: []
  - text: "[anim=tremendinho]Eu venho de um segmento art\xEDstico muito forte derivado
      de minha fam\xEDlia, mas no momento\nn\xE3o tenho conseguido muitos papeis,
      por isso vim conferir a possibilidade de entrar no time.[/anim]"
    autoNextNode: 3
    choices: []
  - text: "[anim=tremendinho]N\xE3o gosto de pepinos, caranguejos e principalmente
      de [anim=bravo] ESPONJAS[/anim], desculpe...\n[anim=gay]Adorei aquele rapaz
      sentado logo ali acho que ele \xE9 um E.T [/anim]"
    autoNextNode: 4
    choices: []
  - text: '[anim=gay]Qualquer coisa estarei por ai, caso precise viu fofinho... [/anim]'
    autoNextNode: 0
    choices: []
