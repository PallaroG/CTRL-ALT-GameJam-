  panel: {fileID: 5115771053224964321}
  dialogueText: {fileID: 945197791475919797}
  choicesParent: {fileID: 0}
  choiceButtonPrefab: {fileID: 0}
  startNode: 0
  nodes:
  - text: '[anim=tremendinho]Opa, beleza?[/anim]'
    autoNextNode: 1
    choices: []
  - text: "[anim=tremendinho]Meu nome \xE9 Rick, eu AMO futebol[/anim]"
    autoNextNode: 2
    choices: []
  - text: "[anim=tremendinho]e as pipocas do est\xE1dio no final do jogo...Hummm[/anim]"
    autoNextNode: 3
    choices: []
  - text: "[anim=tremendinho]Enfim,eu n\xE3o consigo chutar muito forte, mas sou
      leve e sei voar![/anim]"
    autoNextNode: 4
    choices: []
  - text: "[anim=tremendinho]S\xF3 n\xE3o me coloque do lado de nenhum c\xE3o sarnento,
      odeio esses animais pulguentos e barulhentos.[/anim]"
    autoNextNode: 5
    choices: []
  - text: "[anim=tremendinho]Mas adoro Capivara!! elas s\xE3o t\xE3o calminhas[/anim]"
    autoNextNode: 0
    choices: []
