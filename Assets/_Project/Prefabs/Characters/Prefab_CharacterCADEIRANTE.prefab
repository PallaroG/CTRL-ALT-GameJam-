  m_Script: {fileID: 11500000, guid: 4914bca96cc839a4d9050069ff9afbde, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  panel: {fileID: 2375716961246877576}
  dialogueText: {fileID: 732252649521926368}
  choicesParent: {fileID: 0}
  choiceButtonPrefab: {fileID: 0}
  startNode: 0
  nodes:
  - text: "[anim=tremendinho]\u201CBoa tarde meu querido, como vai voc\xEA?[/anim]"
    autoNextNode: 1
    choices: []
  - text: "[anim=tremendinho]Eu sei que n\xE3o aparento muita habilidade, mas ainda
      tenho for\xE7a de luta!![/anim]"
    autoNextNode: 1
    choices: []
  - text: "[anim=tremendinho]Posso surpreender o capit\xE3o, s\xF3 pe\xE7o uma oportunidade!![/anim]"
    autoNextNode: 1
    choices: []
  - text: "[anim=tremendinho]Gostaria de dizer que n\xE3o gosto muito de mancos,
      parece que tentam me copiar, mas n\xE3o\nfazem direito...[/anim]"
    autoNextNode: 1
    choices: []
  - text: "[anim=tremendinho]Mas se tiver algum carro para ajudar na minha locomo\xE7\xE3o,
      seria muito bem vindo haha.\u201D[/anim]"
    autoNextNode: 1
    choices: []
