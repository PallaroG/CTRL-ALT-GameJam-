  panel: {fileID: 6832935522348789200}
  dialogueText: {fileID: 5355213772673429152}
  choicesParent: {fileID: 0}
  choiceButtonPrefab: {fileID: 0}
  startNode: 0
  nodes:
  - text: "[anim=tremendinho]E a\xED meu chapa![/anim]"
    autoNextNode: 1
    choices: []
  - text: '[anim=tremendinho]Eu sou a Cappi, adoro o vento no meu rosto enquanto
      jogo um fute.[/anim]'
    autoNextNode: 2
    choices: []
  - text: "[anim=tremendinho]Se quiser saber eu sou muito boa em chute, tenho \xF3timas
      pernas![/anim]"
    autoNextNode: 3
    choices: []
  - text: "[anim=tremendinho]S\xF3 pe\xE7o que se puder, me coloque o mais distante
      daquele[/anim] [anim=bravo] ind\xEDgena [/anim], [anim=tremendinho] eu tenho
      medo do tamanho da fome dele...[/anim]"
    autoNextNode: 4
    choices: []
  - text: '[anim=tremendinho]Acho melhor ficar junto com[/anim] [anim=feliz]pombos[/anim]'
    autoNextNode: 0
    choices: []
