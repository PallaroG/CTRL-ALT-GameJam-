  m_Script: {fileID: 11500000, guid: 4914bca96cc839a4d9050069ff9afbde, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueText: {fileID: 1993586698}
  choicesParent: {fileID: 1675975163}
  choiceButtonPrefab: {fileID: 6391532048955935353, guid: 863e83be45620a04e8b1f46392b0c811, type: 3}
  continueKey: 32
  startNode: 0
  nodes:
  - text: This demo showcases a flexible dialogue system with advanced animated text
      effects. Press Space to continue.
    autoNextNode: 1
    choices: []
  - text: '[anim=Wave]Each character can be animated individually in real time.[/anim]
      This text is using a typewriter effect combined with a wave animation mixed
      with rainbow animation.'
    autoNextNode: 2
    choices: []
  - text: '[anim=Shake]Effects can be easily switched using animation profiles.[/anim]'
    autoNextNode: 3
    choices: []
  - text: '

      [anim=Rainbow]You can also animate colors dynamically.[/anim]'
    autoNextNode: 4
    choices: []
  - text: 'Choose an effect to preview:'
    autoNextNode: 0
    choices:
    - text: Preview Bounce Effect
      nextNode: 5
      onChoose:
        m_PersistentCalls:
          m_Calls: []
    - text: Preview Impact Effect
      nextNode: 6
      onChoose:
        m_PersistentCalls:
          m_Calls: []
    - text: End Demo
      nextNode: 7
      onChoose:
        m_PersistentCalls:
          m_Calls: []
  - text: '[anim=Bounce]Bounce adds weight and emphasis to characters.[/anim]'
    autoNextNode: 4
    choices: []
  - text: '[anim=Impact]Impact is ideal for dramatic moments.[/anim]'
    autoNextNode: 4
    choices: []
  - text: 'Thank you for checking out Super Animated Dialogue!

'
    autoNextNode: 0
    choices: []
